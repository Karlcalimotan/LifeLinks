{
	"$schema": "https://opencode.ai/config.json",
	"permissions": [
		{ "action": "edit", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "pio run*", "effect": "allow" },
		{ "action": "shell", "resource": "pio test*", "effect": "allow" },
		{ "action": "shell", "resource": "pio check*", "effect": "allow" },
		{ "action": "shell", "resource": "node scripts/merge-pr.mjs*", "effect": "allow" },
		{ "action": "shell", "resource": "gh issue create*", "effect": "allow" },
		{ "action": "shell", "resource": "gh issue list*", "effect": "allow" },
		{ "action": "shell", "resource": "gh issue view*", "effect": "allow" },
		{ "action": "shell", "resource": "gh issue comment*", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr view*", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr list*", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
		{ "action": "shell", "resource": "pio run *upload*", "effect": "deny" },
		{ "action": "shell", "resource": "pio run -t upload*", "effect": "deny" },
		{ "action": "shell", "resource": "pio run --target upload*", "effect": "deny" },
		{ "action": "shell", "resource": "gh pr merge*", "effect": "allow" },
		{ "action": "shell", "resource": "git push*", "effect": "ask" },
		{ "action": "shell", "resource": "git push --force*", "effect": "deny" },
		{ "action": "shell", "resource": "git push -f*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * --force*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * -f*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push origin main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push origin HEAD:main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * HEAD:main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push origin *:main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * *:main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push origin :main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * :main*", "effect": "deny" },
		{ "action": "shell", "resource": "git push * refs/heads/main*", "effect": "deny" }
	]
}
