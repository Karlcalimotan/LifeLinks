{
	"name": "lifelink",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"start": "pnpm --filter web start",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter web test",
		"test:e2e": "pnpm --filter web test:e2e",
		"prisma:generate": "pnpm --filter web prisma:generate",
		"prisma:migrate": "pnpm --filter web prisma:migrate",
		"prisma:deploy": "pnpm --filter web prisma:deploy",
		"seed": "pnpm --filter web seed",
		"gen": "node stack/generators/gen.mjs",
		"stack:check": "node stack/src/verify.mjs --self",
		"api:latency": "node scripts/api-latency.mjs",
		"self-check": "node scripts/self-check.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,md}": ["biome check --write --staged --no-errors-on-unmatched"]
	}
}
