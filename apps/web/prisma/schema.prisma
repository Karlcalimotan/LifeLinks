// LifeLink — fleet crash detection and emergency alert platform.
//
// The event log (`DeviceStateEvent`) is the source of truth for device
// activity. Incidents, trips and telemetry are projections on top of it.
// Device tokens are stored as SHA-256 hashes only; the plaintext is shown once
// at provisioning time and never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app (Supabase transaction pooler).
  url       = env("DATABASE_URL")
  // Direct/session connection used by migrations and introspection.
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DeviceApproval {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TripStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum ImpactStatus {
  SUSPECTED
  CONFIRMED
  ACKNOWLEDGED
  CANCELLED
  RESOLVED
  FALSE_ALARM
}

enum AlertChannel {
  SMS
  HTTP
  EMAIL
}

enum AlertStatus {
  QUEUED
  SENT
  FAILED
  ACKNOWLEDGED
}

enum CommandKind {
  LOCATE
  ARM
  DISARM
  TEST_ALERT
  SET_CONFIG
  ROTATE_TOKEN
}

enum CommandStatus {
  PENDING
  ACKED
  EXPIRED
  FAILED
}

enum DeviceEventType {
  HEARTBEAT
  POWER_LOST
  POWER_RESTORED
  GPS_FIX_LOST
  MODEM_FAULT
  SENSOR_FAULT
  CONFIG_APPLIED
  INCIDENT_CANCELLED
  INCIDENT_CONFIRMED
  OTA_INSTALLED
  OTA_ROLLED_BACK
  SAFE_MODE_ENTERED
  DEVICE_OFFLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditActor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  vehicles          Vehicle[]
  devices           TrackerDevice[]
  trips             Trip[]
  impacts           ImpactEvent[]
  emergencyContacts EmergencyContact[]
  geofences         Geofence[]
  settings          OrgSettings?
  auditLogs         AuditLog[]
}

model Membership {
  id        String     @id @default(cuid())
  orgId     String
  userId    String
  role      MemberRole @default(OPERATOR)
  createdAt DateTime   @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Vehicle {
  id          String        @id @default(cuid())
  orgId       String
  plateNo     String
  make        String
  model       String
  year        Int?
  vin         String?
  driverName  String?
  driverPhone String?
  status      VehicleStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices  TrackerDevice[]
  trips    Trip[]
  impacts  ImpactEvent[]
  geofences Geofence[]

  @@unique([orgId, plateNo])
  @@index([orgId, status])
}

model TrackerDevice {
  id             String         @id @default(cuid())
  orgId          String
  vehicleId      String?
  mac            String         @unique
  label          String
  tokenHash      String         @unique
  approvalStatus DeviceApproval @default(PENDING)
  firmwareVersion String?
  hwVariant      String?
  lastSeenAt     DateTime?
  lastLat        Float?
  lastLng        Float?
  lastFixAt      DateTime?
  lastSpeedKph   Float?
  batteryV       Float?
  rssiDbm        Int?
  satellites     Int?
  ignition       Boolean?
  configRev      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trips    Trip[]
  samples  TelemetrySample[]
  impacts  ImpactEvent[]
  commands DeviceCommand[]
  events   DeviceStateEvent[]

  @@index([orgId, lastSeenAt])
  @@index([vehicleId])
}

model Trip {
  id           String     @id @default(cuid())
  orgId        String
  vehicleId    String
  deviceId     String
  startedAt    DateTime
  endedAt      DateTime?
  distanceM    Float?
  maxSpeedKph  Float?
  status       TripStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicle Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  device  TrackerDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  samples TelemetrySample[]
  impacts ImpactEvent[]

  @@index([vehicleId, startedAt])
  @@index([deviceId, startedAt])
  @@index([orgId, startedAt])
}

model TelemetrySample {
  id             String   @id @default(cuid())
  deviceId       String
  tripId         String?
  clientSampleId String
  recordedAt     DateTime
  lat            Float?
  lng            Float?
  speedKph       Float?
  headingDeg     Float?
  accelG         Float?
  tiltDeg        Float?
  vibration      Boolean?
  satellites     Int?
  hdop           Float?
  batteryV       Float?
  ignition       Boolean?
  createdAt      DateTime @default(now())

  device TrackerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  trip   Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@unique([deviceId, clientSampleId])
  @@index([deviceId, recordedAt])
  @@index([tripId, recordedAt])
}

model ImpactEvent {
  id              String       @id @default(cuid())
  orgId           String
  deviceId        String
  vehicleId       String
  tripId          String?
  clientIncidentId String
  detectedAt      DateTime
  peakAccelG      Float
  tiltDeg         Float
  vibrationCount  Int          @default(0)
  speedKph        Float?
  lat             Float?
  lng             Float?
  gpsAgeS         Int?
  status          ImpactStatus @default(CONFIRMED)
  cancelDeadline  DateTime?
  cancelledAt     DateTime?
  resolvedAt      DateTime?
  resolution      String?
  evidence        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device  TrackerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  alerts  AlertDelivery[]

  @@unique([deviceId, clientIncidentId])
  @@index([orgId, detectedAt])
  @@index([vehicleId, detectedAt])
  @@index([status, detectedAt])
}

model AlertDelivery {
  id            String       @id @default(cuid())
  impactEventId String
  channel       AlertChannel
  target        String
  status        AlertStatus  @default(QUEUED)
  attempts      Int          @default(0)
  providerRef   String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  impact ImpactEvent @relation(fields: [impactEventId], references: [id], onDelete: Cascade)

  @@index([impactEventId, status])
}

model DeviceCommand {
  id        String        @id @default(cuid())
  deviceId  String
  kind      CommandKind
  payload   Json          @default("{}")
  status    CommandStatus @default(PENDING)
  createdAt DateTime      @default(now())
  expiresAt DateTime?
  ackedAt   DateTime?

  device TrackerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, createdAt])
}

model DeviceStateEvent {
  id            String          @id @default(cuid())
  deviceId      String
  clientEventId String?
  type          DeviceEventType
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())

  device TrackerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, clientEventId])
  @@index([deviceId, createdAt])
  @@index([type, createdAt])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  phone     String
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, phone])
  @@index([orgId, active])
}

model Geofence {
  id        String   @id @default(cuid())
  orgId     String
  vehicleId String?
  name      String
  centerLat Float
  centerLng Float
  radiusM   Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicle Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
}

model OrgSettings {
  id                    String   @id @default(cuid())
  orgId                 String   @unique
  impactThresholdG      Float    @default(2.5)
  tiltThresholdDeg      Float    @default(60)
  confirmWindowMs       Int      @default(200)
  cancelWindowS         Int      @default(15)
  heartbeatIntervalS    Int      @default(30)
  sosRetryS             Int      @default(60)
  telemetryRetentionDays Int     @default(30)
  incidentRetentionDays Int      @default(365)
  alertPhones           Json     @default("[]")
  alertEmails           Json     @default("[]")
  parkedImpactAlerts    Boolean  @default(false)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  actorId   String?
  action    String
  target    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([action, createdAt])
}
