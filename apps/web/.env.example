# Supabase (Project Settings -> Database -> Connection string)
#
# Runtime: transaction pooler, port 6543. The app and serverless functions use
# this URL. Keep connection_limit=1 for serverless deployments.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations, introspection and seeding: session connection, port 5432.
# Use the session pooler if your network has no IPv6 route to db.<ref>.supabase.co.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session signing. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Absolute origin used in links and metadata
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cron endpoint bearer secret (api/cron/device-watch)
CRON_SECRET="replace-me"

# Optional signed OTA release. Leave empty to disable OTA updates.
LIFELINK_FIRMWARE_VERSION=""
LIFELINK_FIRMWARE_URL=""
LIFELINK_FIRMWARE_SHA256=""
LIFELINK_FIRMWARE_SIGNATURE=""
LIFELINK_FIRMWARE_NOTES=""

E2E_BASE_URL="http://localhost:3000"
