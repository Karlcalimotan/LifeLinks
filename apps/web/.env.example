# Supabase (Project Settings -> Database -> Connection string)
#
# Runtime: transaction pooler, port 6543. The app and serverless functions use
# this URL. Keep connection_limit=1 for serverless deployments.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations, introspection and seeding: session connection, port 5432.
# Use the session pooler if your network has no IPv6 route to db.<ref>.supabase.co.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional Supabase client keys. Prisma does not use them; add them only when
# the app starts using Supabase Storage, Realtime or the Data API.
# The service-role key bypasses RLS and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Session signing. Production requires at least 32 bytes. Generate with:
# openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Demo login panel. Keep false in production and shared environments. Set to
# "true" only on a local machine with the demo seed, then restart the dev server.
DEMO_MODE="false"

# Absolute origin used in links and metadata
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Web Push (VAPID). Generate a keypair with:
#   pnpm vapid
# The public key is inlined into the browser bundle; the private key and the
# subject stay on the server. Never commit real keys. Leave all three empty to
# disable browser alerts: the console says push is not configured and the
# sender skips without failing an incident.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Cron endpoint bearer secret (api/cron/device-watch)
CRON_SECRET="replace-me"

# Optional signed OTA release. LIFELINK_FIRMWARE_VERSION also drives the
# "Update available" marker on the tracker list. Leave it empty to use the
# firmware version shipped in the repository. OTA stays disabled unless the
# URL, SHA256 and signature are also set.
LIFELINK_FIRMWARE_VERSION=""
LIFELINK_FIRMWARE_URL=""
LIFELINK_FIRMWARE_SHA256=""
LIFELINK_FIRMWARE_SIGNATURE=""
LIFELINK_FIRMWARE_NOTES=""

E2E_BASE_URL="http://localhost:3000"
